# Placeholder configuration only. No M1.1 code loads this file automatically.
NEXUS_ENV=development
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000

# M1.2 PostgreSQL: create ignored infra/.env only after explicit setup approval.
# Compose reads NEXUS_DB_NAME and NEXUS_DB_ADMIN_PASSWORD from that file.
# The built-in postgres administrator is not an application role.
NEXUS_DB_HOST=127.0.0.1
NEXUS_DB_PORT=5432
NEXUS_DB_NAME=nexus_ai
NEXUS_DB_ADMIN_PASSWORD=replace-me

# Future application roles (M1.4 preparation only; not yet deployed).
# nexus_owner is NOLOGIN; it has no password and is never a runtime account.
NEXUS_DB_OWNER=nexus_owner
NEXUS_DB_APP=nexus_app
NEXUS_DB_APP_PASSWORD=replace-me
NEXUS_DB_TOOL=nexus_tool
NEXUS_DB_TOOL_PASSWORD=replace-me

# Future NEXUS AI runtime only; unrelated to OpenCode Big Pickle.
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXUS_OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_PARALLEL=1

# Future server-only BFF upstream; browser uses same-origin routes.
NEXUS_API_BASE_URL=http://127.0.0.1:8000
